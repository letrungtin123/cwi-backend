{
  "name": "cwi-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && node scripts/copyReportDeliveryAssets.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "oxlint src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:export-worker": "tsx watch src/exportWorker.ts",
    "start:export-worker": "node dist/exportWorker.js",
    "dev:report-delivery-worker": "tsx watch src/reportDeliveryWorker.ts",
    "start:report-delivery-worker": "node dist/reportDeliveryWorker.js",
    "dev:report-generation-worker": "tsx watch src/reportGenerationWorker.ts",
    "start:report-generation-worker": "node dist/reportGenerationWorker.js"
  },
  "dependencies": {
    "amqplib": "^0.10.9",
    "busboy": "^1.6.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "nodemailer": "9.1.1",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^3.24.1"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/busboy": "^1.5.4",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^6.4.24",
    "@types/pg": "^8.11.11",
    "oxlint": "^0.15.14",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
