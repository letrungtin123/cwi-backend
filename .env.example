NODE_ENV=development
PORT=8088

# Server-side only. Use the Supabase CWI Postgres connection string.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
DB_SSL=false
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# Comma-separated frontend origins allowed to call the public API and dashboard.
CORS_ALLOWED_ORIGINS=http://localhost:5670,http://127.0.0.1:5670,http://localhost:5275,http://127.0.0.1:5275,http://localhost:5680,http://127.0.0.1:5680

IP_HASH_SECRET=change-me-use-a-long-random-ip-hash-secret

# Server-side Supabase Auth config for dashboard login. Never expose service-role keys.
SUPABASE_AUTH_URL=http://127.0.0.1:55321/auth/v1
SUPABASE_ANON_KEY=change-me-set-from-supabase-api-settings
AUTH_SESSION_COOKIE_NAME=cwi_admin_session
AUTH_CSRF_COOKIE_NAME=cwi_admin_csrf
AUTH_SESSION_TTL_SECONDS=28800
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_DOMAIN=
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=300000
AUTH_LOGIN_RATE_LIMIT_MAX=10

LOG_LEVEL=info
TRUST_PROXY=false
REQUEST_BODY_LIMIT=256kb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# Reserved for the later report backend integration. Disabled for now.
REPORT_SERVICE_ENABLED=false
REPORT_SERVICE_BASE_URL=http://127.0.0.1:8000
REPORT_SERVICE_TIMEOUT_MS=10000