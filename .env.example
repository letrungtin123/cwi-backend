NODE_ENV=development
PORT=8088
HOST=127.0.0.1

# Server-side only. Use the Supabase CWI Postgres connection string.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
DB_SSL=false
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# Comma-separated frontend origins allowed to call the public API and dashboard.
# The production PM2 config also supplies the public HTTPS origin explicitly.
CORS_ALLOWED_ORIGINS=http://localhost:5670,http://127.0.0.1:5670,http://localhost:5275,http://127.0.0.1:5275,http://localhost:5680,http://127.0.0.1:5680,https://ceo-workforce-index.com

IP_HASH_SECRET=change-me-use-a-long-random-ip-hash-secret
# Optional. If omitted, IP_HASH_SECRET is used to sign admin pagination cursors.
ADMIN_CURSOR_SECRET=change-me-use-a-long-random-admin-cursor-secret

# Keep false until the admin export SQL migration has been applied manually.
ADMIN_EXPORT_ENABLED=false
EXPORT_WORKER_LOOP_INTERVAL_MS=2000
EXPORT_WORKER_LOCK_MS=300000
EXPORT_WORKER_MAX_ATTEMPTS=5
REPORT_DELIVERY_ENABLED=false
REPORT_DELIVERY_BUCKET=cwi-submission-report-pdfs
REPORT_UPLOAD_MAX_BYTES=52428800
REPORT_DELIVERY_BATCH_SIZE=500
REPORT_DELIVERY_LOCK_MS=300000
REPORT_DELIVERY_MAX_ATTEMPTS=5
REPORT_DELIVERY_PREFETCH=2
REPORT_DELIVERY_CONCURRENCY=1
REPORT_DELIVERY_REQUEUE_DELAY_MS=5000
RABBITMQ_URL=amqp://cwi_admin:replace-with-secret@127.0.0.1:5673/cwi_vhost
# Microsoft 365 SMTP AUTH over STARTTLS. Keep credentials out of Git.
MAIL_AUTH_MODE=basic
MAIL_SMTP_HOST=smtp.office365.com
MAIL_SMTP_PORT=587
MAIL_SMTP_REQUIRE_TLS=true
MAIL_SMTP_SECURE=false
MAIL_SMTP_CONNECTION_TIMEOUT_MS=30000
MAIL_SMTP_GREETING_TIMEOUT_MS=30000
MAIL_SMTP_SOCKET_TIMEOUT_MS=120000
MAIL_SMTP_MAX_CONNECTIONS=2
MAIL_SMTP_MAX_MESSAGES=100
MAIL_SMTP_USER=reports@your-domain.com
MAIL_SMTP_PASSWORD=
MAIL_M365_TENANT_ID=replace-with-tenant-id
MAIL_M365_CLIENT_ID=replace-with-client-id
MAIL_M365_CLIENT_SECRET=replace-with-client-secret
MAIL_M365_SCOPE=https://outlook.office365.com/.default
MAIL_M365_TOKEN_TIMEOUT_MS=10000
MAIL_FROM_NAME=CEO Workforce Index
MAIL_FROM_ADDRESS=reports@your-domain.com
MAIL_REPLY_TO=contact@your-domain.com
MAIL_SEND_RATE_PER_SECOND=2


# Server-side Supabase Auth config for dashboard login. Never expose service-role keys.
SUPABASE_AUTH_URL=http://127.0.0.1:55321/auth/v1
SUPABASE_STORAGE_URL=http://127.0.0.1:55321/storage/v1
SUPABASE_SERVICE_ROLE_KEY=change-me-server-side-service-role-key
SUPABASE_ANON_KEY=change-me-set-from-supabase-api-settings
AUTH_SESSION_COOKIE_NAME=cwi_admin_session
AUTH_CSRF_COOKIE_NAME=cwi_admin_csrf
AUTH_SESSION_TTL_SECONDS=28800
# Keep false for local HTTP development. Production PM2 forces this to true.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_DOMAIN=
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=300000
AUTH_LOGIN_RATE_LIMIT_MAX=10

LOG_LEVEL=info
TRUST_PROXY=false
REQUEST_BODY_LIMIT=256kb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# Async AI report generation. Keep disabled until the manual SQL file has been applied and cwi-ai is reachable.
REPORT_SERVICE_ENABLED=false
REPORT_SERVICE_BASE_URL=http://127.0.0.1:8000
REPORT_SERVICE_TIMEOUT_MS=10000
REPORT_PARTICIPANT_PHONE_PLACEHOLDER=00000000
REPORT_STORAGE_DIR=./storage/reports
REPORT_STORAGE_BUCKET=cwi-report-assets
REPORT_STORAGE_UPLOAD_TIMEOUT_MS=60000
REPORT_WORKER_LOOP_INTERVAL_MS=2000
REPORT_WORKER_LOCK_MS=300000
REPORT_WORKER_MAX_ATTEMPTS=5
REPORT_WORKER_INITIAL_POLL_DELAY_MS=10000
REPORT_WORKER_MAX_POLL_DELAY_MS=60000
PDF_BROWSER_PATH=
PDF_RENDER_TIMEOUT_MS=120000

