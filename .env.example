NODE_ENV=
PORT=
HOST=

# Server-side only. Use the Supabase CWI Postgres connection string.
DATABASE_URL=
DB_SSL=
DB_POOL_MAX=
DB_IDLE_TIMEOUT_MS=
DB_CONNECTION_TIMEOUT_MS=

# Comma-separated frontend origins allowed to call the public API and dashboard.
# The production PM2 config also supplies the public HTTPS origin explicitly.
CORS_ALLOWED_ORIGINS=

IP_HASH_SECRET=
# Optional. If omitted, IP_HASH_SECRET is used to sign admin pagination cursors.
ADMIN_CURSOR_SECRET=

# Keep false until the admin export SQL migration has been applied manually.
ADMIN_EXPORT_ENABLED=
EXPORT_WORKER_LOOP_INTERVAL_MS=
EXPORT_WORKER_LOCK_MS=
EXPORT_WORKER_MAX_ATTEMPTS=
REPORT_DELIVERY_ENABLED=
REPORT_DELIVERY_BUCKET=
REPORT_UPLOAD_MAX_BYTES=
REPORT_DELIVERY_BATCH_SIZE=
REPORT_DELIVERY_LOCK_MS=
REPORT_DELIVERY_MAX_ATTEMPTS=
REPORT_DELIVERY_PREFETCH=
REPORT_DELIVERY_CONCURRENCY=
REPORT_DELIVERY_REQUEUE_DELAY_MS=
RABBITMQ_URL=
# Microsoft 365 SMTP AUTH over STARTTLS. Keep credentials out of Git.
MAIL_AUTH_MODE=
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=
MAIL_SMTP_REQUIRE_TLS=
MAIL_SMTP_SECURE=
MAIL_SMTP_CONNECTION_TIMEOUT_MS=
MAIL_SMTP_GREETING_TIMEOUT_MS=
MAIL_SMTP_SOCKET_TIMEOUT_MS=
MAIL_SMTP_MAX_CONNECTIONS=
MAIL_SMTP_MAX_MESSAGES=
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=
MAIL_M365_TENANT_ID=
MAIL_M365_CLIENT_ID=
MAIL_M365_CLIENT_SECRET=
MAIL_M365_SCOPE=
MAIL_M365_TOKEN_TIMEOUT_MS=
MAIL_FROM_NAME=
MAIL_FROM_ADDRESS=
MAIL_REPLY_TO=
MAIL_SEND_RATE_PER_SECOND=


# Server-side Supabase Auth config for dashboard login. Never expose service-role keys.
SUPABASE_AUTH_URL=
SUPABASE_STORAGE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
AUTH_SESSION_COOKIE_NAME=
AUTH_CSRF_COOKIE_NAME=
AUTH_SESSION_TTL_SECONDS=
# Keep false for local HTTP development. Production PM2 forces this to true.
AUTH_COOKIE_SECURE=
AUTH_COOKIE_SAME_SITE=
AUTH_COOKIE_DOMAIN=
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=
AUTH_LOGIN_RATE_LIMIT_MAX=

LOG_LEVEL=
TRUST_PROXY=
REQUEST_BODY_LIMIT=
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX=

# Async V3 AI report generation. Keep disabled until the manual SQL file has been applied and cwi-ai is reachable.
REPORT_SERVICE_ENABLED=
REPORT_SERVICE_BASE_URL=
# HMAC secret for per-report public preview tokens. Required and >=32 chars in production.
REPORT_PUBLIC_TOKEN_SECRET=
# Default: 86400 seconds. Keep within 300..604800 seconds.
REPORT_PUBLIC_TOKEN_TTL_SECONDS=
REPORT_SERVICE_TIMEOUT_MS=
REPORT_AUTO_EMAIL_ENABLED=
REPORT_GENERATED_PDF_FILE_NAME=
REPORT_STORAGE_DIR=
REPORT_STORAGE_BUCKET=
REPORT_STORAGE_UPLOAD_TIMEOUT_MS=
REPORT_DEBUG_DUMP_HTML=
REPORT_DEBUG_HTML_DIR=
REPORT_WORKER_LOOP_INTERVAL_MS=
REPORT_WORKER_LOCK_MS=
REPORT_WORKER_MAX_ATTEMPTS=
REPORT_WORKER_INITIAL_POLL_DELAY_MS=
REPORT_WORKER_MAX_POLL_DELAY_MS=
PDF_BROWSER_PATH=
PDF_DISABLE_SANDBOX=
PDF_RENDER_TIMEOUT_MS=
