# Runtime credentials must be generated per environment and kept in .env.
# Never commit the real .env file.
COMPOSE_PROJECT_NAME=cwi-rabbitmq-local
RABBITMQ_CONTAINER_NAME=cwi-rabbitmq-local
RABBITMQ_HOSTNAME=cwi-rabbitmq-local
RABBITMQ_AMQP_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673
RABBITMQ_DEFAULT_USER=cwi_admin
RABBITMQ_DEFAULT_PASS=replace-with-a-long-random-password
RABBITMQ_DEFAULT_VHOST=cwi_vhost
RABBITMQ_VOLUME_NAME=cwi-rabbitmq-local-data
RABBITMQ_NETWORK_NAME=cwi-rabbitmq-local-network
